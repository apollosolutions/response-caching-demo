# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- GraphOS (required) ---
# Response caching is a GraphOS Router feature, so the Router needs a graph
# API key to fetch its license. Create a graph at https://studio.apollographql.com
# and copy its key and graph ref. Free/Developer plans work (rate limits apply).
APOLLO_KEY=service:your-graph:your-key
APOLLO_GRAPH_REF=your-graph@current

# --- Invalidation (required) ---
# Shared secrets for POST http://localhost:4005/invalidation.
# Subgraph and connector entries are authorized separately (scenario 11).
# Generate with: openssl rand -base64 24
INVALIDATION_SHARED_KEY=change-me-subgraphs
CONNECTOR_INVALIDATION_SHARED_KEY=change-me-connectors

# --- Optional ---
# APOLLO_ROUTER_LOG=info
